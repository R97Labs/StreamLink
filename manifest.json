{
  "manifest_version": 3,
  "name": "StreamLink",
  "version": "1.3", 
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "scripting"
  ],
"host_permissions": [
    "<all_urls>",   
    "https://api.streamlink.cloud/*",
    "https://streamlink.cloud/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://streamlink.cloud/*"],  
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}