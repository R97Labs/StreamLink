{
  "manifest_version": 3,
  "name": "StreamLink",
  "version": "1.2",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "https://streamlinkcloud.pages.dev/*",
    "https://StreamLinkcloud.r97group.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://streamlinkcloud.pages.dev/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}